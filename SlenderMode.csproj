<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SlenderMode v.0.16.0</AssemblyName>
    <RootNamespace>SlenderMode</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS0618;CS0649;CS0169;CS0414;CS0162</NoWarn>

    <!-- Change this if your game is installed somewhere else, or pass -p:TLDPath="..." -->
    <TLDPath Condition="'$(TLDPath)' == ''">H:\SteamLibrary\steamapps\common\TheLongDark</TLDPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- only the mod sources and the bundled NLayer MP3 decoder (MIT) -->
    <Compile Remove="**" />
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- MelonLoader core -->
    <Reference Include="$(TLDPath)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(TLDPath)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(TLDPath)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(TLDPath)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />
    <!-- Game + Unity assemblies (generated by MelonLoader the first time you start the game) -->
    <Reference Include="$(TLDPath)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
    <!-- ModSettings mod (required) -->
    <Reference Include="$(TLDPath)\Mods\ModSettings.dll" Private="false" />
  </ItemGroup>

  <!-- Drop the finished DLL straight into the game's Mods folder -->
  <Target Name="CopyToMods" AfterTargets="Build" Condition="Exists('$(TLDPath)\Mods')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TLDPath)\Mods" />
    <Message Importance="high" Text="Installed: $(TLDPath)\Mods\$(TargetFileName)" />
  </Target>

</Project>
